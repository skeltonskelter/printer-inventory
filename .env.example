# Copy this file to .env. Set your own password before starting Docker Compose.
POSTGRES_DB=printer_inventory
POSTGRES_USER=printerapp
POSTGRES_PASSWORD=change_me

# Frontend entry point: http://localhost:8080 (use 80 on your Ubuntu server).
APP_PORT=8080
# Bind to your VM's internal IP for LAN access, or 127.0.0.1 behind a host proxy.
APP_BIND_ADDRESS=0.0.0.0
# Use a unique tag for each production release; do not rebuild an old tag.
APP_VERSION=local

# Used only with docker-compose.dev.yml; binds PostgreSQL to localhost.
POSTGRES_PORT=5432

# Business date used to reject future-dated relocations.
APP_TIME_ZONE=Asia/Manila
